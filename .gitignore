# ═══════════════════════════════════════════════════════════════════
# DataMind-King — .gitignore (ENSURE SECRETS ARE NEVER COMMITTED)
# ═══════════════════════════════════════════════════════════════════

# ── Secrets & Config ───────────────────────────────────────────────
# ALL .env files (except .env.example)
.env
.env.*.local
.env.local
.env.production
.env.staging
.env.development
!/.env.example
!/.env.template

# Secrets directory (if used)
.secrets/
!.secrets/.gitkeep

# Certificates & keys
*.pem
*.key
*.crt
*.p12
*.pfx

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
.venv/
venv/
ENV/
env/

# ── Node / Frontend ────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/.cache/
*.tsbuildinfo
next-env.d.ts

# ── Docker ─────────────────────────────────────────────────────────
.docker/
!.dockerignore

# ── IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Logs ───────────────────────────────────────────────────────────
*.log
logs/

# ── OS ─────────────────────────────────────────────────────────────
Thumbs.db

# ── Claude / AI Tools ────────────────────────────────────────────
.claude/
!.claude/settings.json

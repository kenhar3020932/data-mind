# DataMind-King Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=DataMind-King
APP_ENV=development
DEBUG=true

# Security
SECRET_KEY=your-super-secret-key-at-least-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/datamind
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_CLEANED=cleaned
MINIO_BUCKET_ARCHIVED=archived

# LLM / Brain
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
DEFAULT_MODEL=claude-sonnet-4-20250514
PLANNING_MODEL=claude-opus-4-20250514
SIMPLE_MODEL=claude-haiku-3-20241022

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# SQL Gate
SQL_GATE_ENABLED=true
SQL_ALLOWED_DIALECTS=["duckdb","postgres"]
SQL_MAX_QUERY_LENGTH=5000

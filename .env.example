# ═══════════════════════════════════════════════════════════════════
# DataMind-King — Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#
# COPY THIS FILE TO .env AND OVERRIDES WITH REAL VALUES BEFORE DEPLOYING
# NEVER commit this file with real secrets to version control
# Use: cp .env.production .env  (then fill in secrets)
#
# 🔑 SECRETS — Replace ALL CHANGE_ME values before deploying.
#   SECRET_KEY     → openssl rand -base64 48
#   ANTHROPIC_API_KEY → https://console.anthropic.com (sk-ant-...)
#   POSTGRES_PASSWORD → openssl rand -hex 32
#   MINIO_ROOT_USER/ROOT_PASSWORD → openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────────
APP_NAME=DataMind-King
APP_ENV=production                # development | staging | production
DEBUG=false                       # NEVER enable in production

# ──────────────────────────────────────────────────────────────────
# SECURITY — JWT & Authentication
# ──────────────────────────────────────────────────────────────────
# Must be ≥32 chars. Generate with: openssl rand -base64 48
SECRET_KEY=your-32-char-minimum-secret-key-here-replace-this!!!

# JWT configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# 2FA / TOTP
TOTP_ISSUER=DataMind-King
TOTP_DIGITS=6
TOTP_PERIOD=30

# ──────────────────────────────────────────────────────────────────
# DATABASE — PostgreSQL (Primary)
# ──────────────────────────────────────────────────────────────────
# Production: use managed Postgres (RDS, Cloud SQL, Supabase, etc.)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://datamind_user:your-db-password-here@localhost:5432/datamind

# Individual Postgres params (used by migration scripts)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=datamind_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=datamind

# Connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ──────────────────────────────────────────────────────────────────
# CACHE & QUEUES — Redis
# ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Redis keyspace for jobs/cache
REDIS_DB=0

# ──────────────────────────────────────────────────────────────────
# OBJECT STORAGE — MinIO / S3-compatible
# ──────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin-change-me
MINIO_SECRET_KEY=minioadmin-change-me
MINIO_SECURE=false                    # true in production with TLS
MINIO_REGION=us-east-1

# Buckets (created automatically on first run)
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_CLEANED=cleaned
MINIO_BUCKET_ARCHIVED=archived
MINIO_BUCKET_REPORTS=reports
MINIO_BUCKET_MODELS=models

# ──────────────────────────────────────────────────────────────────
# LLM / BRAIN — Anthropic Claude API
# ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-real-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model tiering — Brain routes tasks to cheapest capable model
DEFAULT_MODEL=claude-sonnet-4-20250514    # General analysis
PLANNING_MODEL=claude-opus-4-20250514    # Complex planning (expensive)
SIMPLE_MODEL=claude-haiku-3-20241022     # Quick tasks (cheap)
FREE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct-Public    # Fallback when budget exhausted

# Budget controls
BUDGET_PER_REQUEST_USD=0.05
DAILY_BUDGET_USD=50.0
MONTHLY_BUDGET_USD=1000.0

# ──────────────────────────────────────────────────────────────────
# CORS — Cross-Origin Resource Sharing
# ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only in development.
CORS_ORIGINS=["https://datamind.example.com","https://admin.datamind.example.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_HEADERS=["*"]
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]

# ──────────────────────────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BAN_DURATION_SECONDS=300

# ──────────────────────────────────────────────────────────────────
# SQL GATE — Query Security
# ──────────────────────────────────────────────────────────────────
SQL_GATE_ENABLED=true
SQL_ALLOWED_DIALECTS=["duckdb","postgres","clickhouse","trino"]
SQL_MAX_QUERY_LENGTH=5000
SQL_BLOCKED_KEYWORDS="DROP,DELETE,INSERT,UPDATE,TRUNCATE,ALTER,DATABASE,GRANT,REVOKE,UNION"

# ──────────────────────────────────────────────────────────────────
# OBSERVABILITY — OpenTelemetry + Prometheus
# ──────────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=datamind-king
OTEL_ENABLED=true
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus
OTEL_LOGS_EXPORTER=logging

# OTLP endpoints (Jaeger, Tempo, etc.)
OTEL_TRACES_ENDPOINT=http://localhost:4317
OTEL_METRICS_ENDPOINT=http://localhost:9090
OTEL_EXPORTER_TIMEOUT_MS=10000

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

# ──────────────────────────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                 # json | text
LOG_REQUEST_ID_HEADER=X-Request-ID
LOG_TRACE_ID_HEADER=X-Trace-ID

# ──────────────────────────────────────────────────────────────────
# BI TOOLS — Superset / Metabase / Grafana
# ──────────────────────────────────────────────────────────────────
# Provisioned per-organization. URLs generated dynamically.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ──────────────────────────────────────────────────────────────────
# SSO / IDENTITY (Optional — disable if not used)
# ──────────────────────────────────────────────────────────────────
SSO_ENABLED=false
SSO_PROVIDER=okta               # okta | azure-ad | google | keycloak
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://datamind.example.com/auth/callback

# ──────────────────────────────────────────────────────────────────
# DATA ENGINES (optional, for multi-engine deployments)
# ──────────────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=datamind

TRINO_COORDINATOR=http://localhost:8080
TRINO_USER=datamind
TRINO_CATALOG=memory
TRINO_SCHEMA=default

# ──────────────────────────────────────────────────────────────────
# UPLOAD / FILE STORAGE
# ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_BYTES=1073741824          # 1 GB
UPLOAD_ALLOWED_EXTENSIONS=.parquet,.csv,.json,.xlsx,.zip
UPLOAD_Multipart_CHUNK_SIZE_MB=64
UPLOAD_Multipart_MAX_PARTS=10000

# ──────────────────────────────────────────────────────────────────
# FRONTEND — Next.js (NEXT_PUBLIC_ prefix required)
# ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://datamind.example.com
NEXT_PUBLIC_API_URL=https://api.datamind.example.com
NEXT_PUBLIC_WS_URL=wss://ws.datamind.example.com
NEXT_PUBLIC_OTEL_SERVICE_NAME=datamind-king-frontend

# ──────────────────────────────────────────────────────────────────
# DEMO / SEED DATA (safe to enable in development)
# ──────────────────────────────────────────────────────────────────
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@datamind.local
SEED_ADMIN_PASSWORD=Admin@12345678
SEED_ORG_ID=00000000-0000-0000-0000-000000000001
